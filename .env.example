# ── LLM ───────────────────────────────────────────────
# Default provider for ALL design agents: "mock" (offline, deterministic),
# "claude", or "groq".
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Model id; defaults to claude-sonnet-4-6 (claude-opus-4-8 is more capable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Free AI for the adaptive interview (Groq, OpenAI-compatible) ──
# Get a free key (no credit card) at https://console.groq.com/keys
# When GROQ_API_KEY is set, the interview automatically asks AI-generated,
# concept-aware questions via Groq, while the rest of the pipeline stays on
# LLM_PROVIDER above. Leave empty to keep the deterministic question plan.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional override of the interview provider ("groq" | "mock" | "claude").
# Defaults to "groq" when GROQ_API_KEY is set, else falls back to LLM_PROVIDER.
# INTERVIEW_LLM_PROVIDER=groq

# ── Database (PostgreSQL via Prisma) ──────────────────
# Matches docker-compose (host port 5433 to avoid clashing with a local 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/archivato?schema=public

# ── Redis / BullMQ (used in a later slice) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────
PORT=3001

# ── Auth (Slice 9) ────────────────────────────────────
# Secret used to sign the access-token JWT. CHANGE THIS in any real deploy.
JWT_ACCESS_SECRET=dev-insecure-secret-change-me
# Access-token lifetime in seconds (default 900 = 15 min) and refresh lifetime in days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Origin allowed by CORS (the Next.js web app). Cookies require an exact origin.
WEB_ORIGIN=http://localhost:3000
# Cookie flags. Set COOKIE_SECURE=true behind HTTPS; use SameSite=none for
# cross-domain prod deployments (requires Secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Email (Slice 9b — verification & password reset) ──
# Delivery priority: (1) real SMTP when SMTP_HOST is set; (2) Ethereal preview
# when MAIL_PREVIEW=true and no SMTP (actually sends to a throwaway inbox and
# logs a clickable preview URL — zero setup); (3) otherwise just logs the link.
MAIL_PREVIEW=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Gmail: use an App Password as SMTP_PASS and your address as SMTP_USER;
# Gmail may rewrite SMTP_FROM to the authenticated account.
SMTP_FROM=no-reply@archivato.local
