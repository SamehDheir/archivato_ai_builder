# ── LLM ───────────────────────────────────────────────
# ONE SWITCH for every agent (interview + all design agents):
#   • leave LLM_PROVIDER unset  → auto: Groq when GROQ_API_KEY is set,
#                                 else Azure when AZURE_OPENAI_API_KEY is set,
#                                 else mock
#   • LLM_PROVIDER=claude|groq|azure → force that provider for everything
# So just pasting GROQ_API_KEY below flips the WHOLE pipeline to real (free) AI.
# Every agent keeps a deterministic fallback if the model returns bad output.
#
# Leave LLM_PROVIDER unset. Forcing `mock` makes every agent emit deterministic
# template output and reports $0 AI spend, which reads as a broken pipeline.
# Required only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Model id; defaults to claude-sonnet-4-6 (claude-opus-4-8 is more capable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Free AI (Groq, OpenAI-compatible) — powers the whole pipeline ──
# Get a free key (no credit card) at https://console.groq.com/keys
# When set (and LLM_PROVIDER is not forcing something else), EVERY agent —
# the adaptive interview AND all design agents — uses Groq. Leave empty for the
# offline mock (deterministic question plan + deterministic artifact builders).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Azure OpenAI (e.g. Microsoft for Startups credits) ──
# The model is picked by the DEPLOYMENT name, not a model id. All three are
# required to use this provider. Groq keeps priority when both keys are set —
# use LLM_PROVIDER=azure to force Azure.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Optional; defaults to a GA version that supports JSON mode.
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: pin ONLY the interview to a provider, independent of the rest.
# Defaults to the one-switch resolution above.
# INTERVIEW_LLM_PROVIDER=groq

# ── Database (PostgreSQL via Prisma) ──────────────────
# Matches docker-compose (host port 5433 to avoid clashing with a local 5432).
#
# DATABASE_URL is the RUNTIME connection; DIRECT_URL is used by `prisma migrate`
# only. Locally they are the same database, so just copy the value.
#
# On Supabase (or any pgBouncer setup) they DIFFER — see DEPLOY.md:
#   DATABASE_URL = transaction pooler, port 6543, ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct connection,  port 5432   (pgBouncer cannot run DDL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/archivato?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/archivato?schema=public

# ── Redis / BullMQ (job queue + health readiness check) ────────────
# Local docker-compose: no auth, no TLS — host/port is enough.
REDIS_HOST=localhost
REDIS_PORT=6379
#
# Managed Redis (Upstash, Render Key Value, …) issues a single URL carrying the
# credentials and TLS. When REDIS_URL is set it WINS over REDIS_HOST/PORT — a
# bare host/port cannot authenticate to a managed instance. The `rediss://`
# scheme (two s's) means TLS and is what every provider hands you.
# REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# ── Error monitoring (optional) ───────────────────────
# Set SENTRY_DSN to report unhandled server errors (5xx) to Sentry with request
# context. Unset → Sentry is a no-op. Startup logs "Sentry error monitoring
# enabled" when active.
SENTRY_DSN=
# Fraction of transactions traced for performance (0 = off).
SENTRY_TRACES_SAMPLE_RATE=0

# ── API ───────────────────────────────────────────────
PORT=3001
# Rate limiting keys off the client IP. Behind a reverse proxy / load balancer
# (most prod hosts: Nginx, Render, Railway, Fly, Vercel), set this so req.ip is
# the real client, not the proxy — otherwise all traffic shares one bucket.
# Values: `true` (trust all — typical for a single managed proxy), a hop count
# like `1`, or a subnet. Leave UNSET for local dev (direct connections).
# TRUST_PROXY=true

# ── Runtime ───────────────────────────────────────────
# Set NODE_ENV=production in any real deploy. It auto-secures cookies AND turns
# on strict env validation (the app REFUSES to boot with a weak/default/missing
# JWT_ACCESS_SECRET — see config/env.validation.ts). Leave unset for local dev.
# NODE_ENV=production

# ── Auth (Slice 9) ────────────────────────────────────
# Secret used to sign the access-token JWT. The dev default below is a KNOWN
# insecure value — with NODE_ENV=production the app will not start unless you
# replace it with a unique secret of >= 32 chars. Generate one with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-insecure-secret-change-me
# Access-token lifetime in seconds (default 900 = 15 min) and refresh lifetime in days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Origin allowed by CORS (the Next.js web app). Cookies require an exact origin.
WEB_ORIGIN=http://localhost:3000
# Public origin of THIS API — used to build OAuth callback URLs.
API_ORIGIN=http://localhost:3001
# Cookie flags. NODE_ENV=production auto-secures cookies; behind HTTPS in dev set
# COOKIE_SECURE=true. For a cross-domain deploy (web + api on different domains)
# use COOKIE_SAMESITE=none, which REQUIRES Secure (enforced at boot).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── OAuth (Slice 9c — Google / GitHub) ────────────────
# A provider is enabled only when BOTH its id and secret are set.
# Register these callback URLs in each provider's app settings:
#   Google → http://localhost:3001/api/auth/oauth/google/callback
#   GitHub → http://localhost:3001/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── "Connect with GitHub" for one-click scaffold push ─────────────────────────
# You can REUSE the login GitHub OAuth App above — just add this callback URL to
# that app's "Authorization callback URLs":
#   http://localhost:3001/api/scaffold/github/connect/callback
# Then leave the two vars below EMPTY (the scaffold flow falls back to
# GITHUB_CLIENT_ID/SECRET). Only set these if you want a dedicated OAuth App.
# Without any GitHub OAuth App, the "Connect with GitHub" button still shows but
# is inactive — users fall back to pasting a token.
GITHUB_SCAFFOLD_CLIENT_ID=
GITHUB_SCAFFOLD_CLIENT_SECRET=
# Optional dedicated key to encrypt stored GitHub tokens at rest (AES-256-GCM).
# Falls back to JWT_ACCESS_SECRET if unset. Generate: openssl rand -base64 48
GITHUB_TOKEN_SECRET=

# ── Email (verification & password reset) ────────────
# MAIL_PROVIDER forces the transport; otherwise it auto-resolves in priority:
#   Resend (RESEND_API_KEY) → SMTP (SMTP_HOST) → Ethereal preview
#   (MAIL_PREVIEW=true) → console log. The resolved provider is logged on boot;
#   running `preview`/`log` under NODE_ENV=production logs a loud warning
#   because those DON'T deliver real mail.
# MAIL_PROVIDER=resend            # resend | smtp | preview | log
# The From address (provider-agnostic). For Resend/SMTP this MUST be an address
# on a domain you've verified with the provider, or delivery is rejected.
MAIL_FROM=no-reply@archivato.local

# (1) Resend — recommended for production. Works where SMTP ports are blocked
# (most PaaS hosts). Get a key + verify a sending domain at https://resend.com.
RESEND_API_KEY=

# (2) SMTP — any relay via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Gmail: use an App Password as SMTP_PASS and your address as SMTP_USER;
# Gmail may rewrite the From to the authenticated account.
# Legacy alias for MAIL_FROM (still honored if MAIL_FROM is unset).
SMTP_FROM=no-reply@archivato.local

# (3) Ethereal preview — zero-setup local dev only (NOT real delivery).
MAIL_PREVIEW=true

# ── Billing / subscriptions (project quota: Free = 1, Pro = $19/mo = 5) ──
# Leave BILLING_PROVIDER unset → mock (instant upgrade/cancel, no charge, offline).
# Set to `paddle` (or just provide PADDLE_API_KEY) to use real Paddle checkout.
#   BILLING_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# Point a Paddle webhook (subscription.* events) at:
#   POST http://localhost:3001/api/billing/webhook  (use ngrok to expose it locally)

# ── SuperAdmin ────────────────────────────────────────────────────────────────
# A single Super Admin account is SEEDED on boot from the two vars below — no
# self-registration needed. Set both to create a ready-to-log-in admin who sees
# the /admin dashboard (users, revenue, traffic) and can provision staff.
# Credentials are managed as config; change the password via SUPER_ADMIN_PASSWORD.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Legacy: comma-separated emails promoted to admin on login. Superseded by the
# seeded account above; leave empty unless you still rely on it.
ADMIN_EMAILS=

# ── Visitor geolocation (waitlist + analytics country) ────────────────────────
# Country is resolved per request: a CDN/edge country header first (Cloudflare
# CF-IPCountry, Vercel x-vercel-ip-country, …), then an offline geoip-lite lookup
# if that OPTIONAL package is installed. Behind a CDN you need nothing here.
# Set to `false` to force header-only even when geoip-lite is present.
# GEOIP_FALLBACK=false

# ── Production deploy (docker-compose.prod.yml) — see DEPLOY.md ────────────────
# Postgres credentials for the bundled `db` service (the API's DATABASE_URL is
# derived from these inside compose).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=archivato
# Web build args — baked into the client bundle at BUILD time (not runtime).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
