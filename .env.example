# ── LLM ───────────────────────────────────────────────
# Which provider the API uses: "mock" (offline, deterministic) or "claude"
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Model id; defaults to claude-sonnet-4-6 (claude-opus-4-8 is more capable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Database (used in a later slice) ──────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archivato?schema=public

# ── Redis / BullMQ (used in a later slice) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────
PORT=3001
