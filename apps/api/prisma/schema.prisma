// Archivato persistence — PostgreSQL via Prisma.
//
// Each pipeline stage's artifact is stored as JSON keyed by the interview
// session, so the rich generated documents are persisted faithfully while the
// app keeps using the shared TypeScript types. Deleting a session cascades to
// all of its artifacts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Authentication (Slice 9) -------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  // Null for accounts created purely via OAuth (Slice 9c).
  passwordHash  String?
  displayName   String
  emailVerified Boolean  @default(false)
  // Access role. 'admin' unlocks the superAdmin dashboard; bootstrapped from the
  // ADMIN_EMAILS env allowlist on login. Everyone else is a normal 'user'.
  role          String   @default("user") // 'user' | 'admin'
  // Linked OAuth providers, e.g. ["google"] (Slice 9c). Empty for local-only.
  providers     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens       RefreshToken[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  deviceRegistrations DeviceRegistration[]
  // RBAC: roles assigned to this user (many-to-many via UserRole).
  userRoles           UserRole[]
  subscription        Subscription?
  // Optional stored GitHub connection for one-click scaffold push.
  githubConnection    GithubConnection?
  // Pipeline projects owned by this user (ownership enforcement).
  interviewSessions   InterviewSession[]
  // Support Center: tickets the user opened + tickets assigned to them (admins).
  supportTickets      SupportTicket[]          @relation("SupportTicketOwner")
  assignedTickets     SupportTicket[]          @relation("SupportTicketAssignee")

  @@map("users")
}

// Billing: one subscription row per user (free by default; upgraded to pro via
// the BillingProvider). The dollar amounts are plan prices; capacity is a
// PROJECT-COUNT quota enforced at project creation (free = 1 project, pro = 5).
// Paddle ids are null in mock mode.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // 'free' | 'pro'
  status               String    @default("active") // 'active' | 'canceled' | 'past_due'
  // Pro billing window; the pro quota counts usage within it. Null for free.
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  paddleCustomerId     String?
  paddleSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

// One-account-per-device enforcement (anti-spam). On local registration the
// client computes a browser fingerprint; we store only its SHA-256 hash and
// refuse a second registration from a device that already has an account. The
// unique constraint makes the block race-safe. Cascades on user delete so a
// removed account frees its device for a fresh sign-up.
model DeviceRegistration {
  id              String   @id @default(uuid())
  fingerprintHash String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("device_registrations")
}

// Stored GitHub connection for one-click scaffold push. The OAuth access token
// is encrypted at rest (AES-256-GCM) — only the ciphertext is stored here, never
// the raw token. One connection per user; cascades on account delete.
model GithubConnection {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AES-256-GCM ciphertext (iv:tag:data, base64) of the GitHub access token.
  tokenEncrypted String
  // The connected GitHub login/username (for display + repo URLs).
  githubLogin    String
  // Space-separated scopes granted, for diagnostics.
  scopes         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("github_connections")
}

// One-time password (OTP) codes for forgot-password (Slice 9b). Only the
// SHA-256 hash of the 6-digit code is stored; short-lived and single-use, with
// an attempt counter to bound guessing.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Single-use email-verification tokens (Slice 9b). Like refresh tokens, only a
// SHA-256 hash is stored; the raw value travels in the emailed link.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Opaque rotating refresh tokens. We store only a SHA-256 hash of the token;
// the raw value lives solely in the client's httpOnly cookie. Rotated on every
// refresh and revoked on logout.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// --- RBAC (roles & permissions) -----------------------------------------------
//
// Dynamic, DB-managed roles. The *permission catalog* is code-defined
// (@archivato/shared), but which permissions a role grants — and which roles a
// user holds — are editable at runtime. A user's effective permissions are the
// union of their roles' `permissions`. Seeded system roles are `isSystem` (can't
// be deleted / key-renamed). Permissions are stored as validated string arrays
// (project convention, cf. User.providers), not Prisma enums.

model Role {
  id          String   @id @default(uuid())
  // Stable slug used by code + bootstrapping (e.g. "super_admin"). Unique.
  key         String   @unique
  name        String
  description String   @default("")
  permissions String[] @default([]) // Permission[] (validated against the catalog)
  // Seeded roles are protected from deletion and key edits.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// --- Pipeline -----------------------------------------------------------------

model InterviewSession {
  id              String   @id @default(uuid())
  // Owner of this project. Nullable so pre-ownership rows survive the migration;
  // every session created from now on is stamped with the authenticated user.
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea            String
  /// Optional user-set display name; the UI falls back to `idea` when null.
  title           String?
  industry        String?
  scale           String?
  preferredStack  String?
  status          String   @default("collecting")
  intent          Json?
  history         Json // InterviewExchange[]
  pendingQuestion Json? // the question awaiting an answer (adaptive interview)
  coverage        Float    @default(0)
  summary         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requirementDocument RequirementDocument?
  systemDesign        SystemDesign?
  databaseDesign      DatabaseDesign?
  apiDesign           ApiDesign?
  reviewReport        ReviewReport?
  productVision       ProductVision?
  roadmap             ProjectRoadmap?
  costEstimate        CostEstimate?
  chatMessages        ChatMessage[]
  versions            ProjectVersion[]
  // Support tickets a customer optionally linked to this project.
  supportTickets      SupportTicket[]

  @@index([userId])
  @@map("interview_sessions")
}

// Project version history (Slice 12). Each modification snapshots every artifact
// as the next sequential version so the project can be compared and restored.
model ProjectVersion {
  id        String           @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version   Int
  label     String
  snapshot  Json // ProjectSnapshot (all five artifacts, nullable each)
  createdAt DateTime         @default(now())

  @@unique([sessionId, version])
  @@index([sessionId])
  @@map("project_versions")
}

// Post-generation refinement chat (Slice 10). One row per message; the design
// artifacts themselves live in their own tables and are overwritten in place.
model ChatMessage {
  id        String           @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime         @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model RequirementDocument {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("requirement_documents")
}

model SystemDesign {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("system_designs")
}

model DatabaseDesign {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("database_designs")
}

model ApiDesign {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("api_designs")
}

model ReviewReport {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("review_reports")
}

// Product Vision (Product Manager stage). Standalone artifact — a product
// strategy view (vision/goals/MVP/roadmap/metrics/personas) of the session.
model ProductVision {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("product_visions")
}

// Project Roadmap (Roadmap Planner stage). Standalone artifact — a phased
// implementation plan (phases → milestones → tasks) derived from the pipeline.
model ProjectRoadmap {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("project_roadmaps")
}

// Cost Estimate (Cost Estimator stage). Standalone artifact — a deterministic
// per-provider monthly hosting projection at 100/1k/10k users, derived from the
// generated design (not from an LLM).
model CostEstimate {
  sessionId String           @id
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("cost_estimates")
}

// --- Analytics (superAdmin) ---------------------------------------------------

// A single analytics event powering the admin dashboard: anonymous landing
// pageviews (type='pageview') plus product events (signup/login/generate…).
// `visitorId` is a hashed, cookie-scoped anonymous id for unique-visitor counts;
// `userId` is set (loosely, no FK) when the actor is signed in. `meta` holds
// small type-specific extras (e.g. the generated stage).
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String // 'pageview' | 'signup' | 'login' | 'generate'
  path      String?
  referrer  String?
  visitorId String?
  userId    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// --- Customer Support Center --------------------------------------------------
//
// A professional ticketing system with an embedded AI Support Assistant.
// Enum-like fields (status/priority/category/authorType) are stored as plain
// strings validated by the shared union types, matching the project convention
// (subscription plan, account role, interview status) rather than Prisma enums.

model SupportTicket {
  id         String            @id @default(uuid())
  // Human-friendly sequential ticket number (#1, #2, …) for display/search.
  number     Int               @unique @default(autoincrement())
  // Owner (the customer who opened it). Cascades on account delete.
  userId     String
  user       User              @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Optional related project; SetNull so deleting a project keeps the ticket.
  sessionId  String?
  session    InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // Assigned admin (SetNull so removing an admin unassigns rather than deletes).
  assigneeId String?
  assignee   User?             @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  subject  String
  category String // SupportCategory
  priority String @default("medium") // SupportPriority
  status   String @default("open") // SupportTicketStatus

  // Denormalized activity markers driving SLA metrics + list ordering.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      SupportMessage[]
  attachments   SupportAttachment[]
  internalNotes SupportInternalNote[]
  events        SupportTicketEvent[]
  aiSuggestions SupportAiSuggestion[]

  @@index([userId])
  @@index([assigneeId])
  @@index([sessionId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // 'customer' | 'admin' | 'ai' | 'system'
  authorType String
  // Null for AI/system messages (loosely referenced user id otherwise, no FK).
  authorId   String?
  body       String
  // When authorType='ai': which layer produced it ('in_ticket' | …).
  aiLayer    String?
  createdAt  DateTime      @default(now())

  attachments SupportAttachment[]

  @@index([ticketId])
  @@map("support_messages")
}

// Attachment metadata. For text-based files (logs/txt/json) the extracted text
// is stored inline (`textContent`) so the AI can analyze it; binary files
// (images/pdf/zip) are metadata-only — no binary is persisted or served.
model SupportAttachment {
  id          String          @id @default(uuid())
  ticketId    String
  ticket      SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId   String?
  message     SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename    String
  mimeType    String
  sizeBytes   Int
  textContent String? // extracted text (text-based files only); null for binary
  createdAt   DateTime        @default(now())

  @@index([ticketId])
  @@map("support_attachments")
}

// Admin-only private note on a ticket — never returned to the customer.
model SupportInternalNote {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_internal_notes")
}

// Immutable timeline entry (created / replied / status change / assigned / …).
model SupportTicketEvent {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String // SupportEventType
  actorType String // 'customer' | 'admin' | 'ai' | 'system'
  actorId   String?
  data      Json? // small payload, e.g. { from, to }
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ticket_events")
}

// A persisted AI analysis run against a ticket (in-ticket assistant / copilot).
model SupportAiSuggestion {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  layer     String // SupportAiLayer ('in_ticket' | 'admin_copilot')
  data      Json // SupportAiAnalysis
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ai_suggestions")
}

// Pre-ticket AI deflection log (and other ad-hoc "Ask AI" runs). Loosely tied to
// a user id (no FK). `deflected` marks a run that avoided creating a ticket.
model SupportAiInteraction {
  id        String   @id @default(uuid())
  userId    String?
  kind      String // 'deflection' | 'ask'
  query     String
  response  Json // SupportDeflectionResult
  deflected Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("support_ai_interactions")
}

// --- Marketing waitlist -------------------------------------------------------

// A public landing-page waitlist signup. Email is unique + normalized
// (trim + lowercase) so signup can be idempotent.
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String? // UI locale at signup (e.g. 'en' | 'ar')
  source    String? // optional campaign/section tag
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

// --- Billing audit log --------------------------------------------------------

// A billing lifecycle event, used for the billing-admin trends chart and the
// per-customer history timeline. Recorded best-effort on checkout / cancel and
// on admin grant / revoke. No FK (kept append-only + independent of cascades).
model BillingEvent {
  id        String   @id @default(uuid())
  userId    String
  actorId   String? // the admin who performed an admin action (null = self/system)
  type      String // BillingEventType
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("billing_events")
}
